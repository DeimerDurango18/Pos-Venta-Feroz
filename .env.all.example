# =============================================================
# POS — DESPLIEGUE EN 1 COMANDO (instalación para el cliente)
# Copiar a .env.all y rellenar. NUNCA commitear .env.all.
#
#   cp .env.all.example .env.all
#   docker compose -f compose.all.yml --env-file .env.all up -d
#
# Los dominios deben apuntar (DNS A) al servidor donde corre Docker.
# HTTPS (Let's Encrypt) lo gestiona Caddy automáticamente.
# =============================================================

# --- Dominios públicos de instalación ---
# App (frontend) y API (backend). Sin camino en DNS no obtiene certificado.
DOMAIN_APP=pos.cliente.co
DOMAIN_API=api.pos.cliente.co

# --- Base de datos ---
# Debe cumplir política de SQL Server: mayúscula+minúscula+dígito+símbolo, >=8.
SA_PASSWORD=CambiaEstaClave2026!
SA_EDITION=Developer
MSSQL_MEMORY_LIMIT_MB=2048
DB_NAME=posdb

# --- Seguridad backend ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria-de-32-caracteres-minimo
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
# Coma separada: solo el(los) dominio(s) autorizados a llamar la API.
# Si se deja vacío usa https://DOMAIN_APP automáticamente.
CORS_ORIGINS=

# --- Usuarios iniciales (solo primera instalación) ---
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_PASSWORD=cajero123
SEED_ADMIN_FORCE_CHANGE=1

# --- DIAN (mantener disabled hasta habilitación) ---
DIAN_ENVIRONMENT=disabled
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=
DIAN_CERTIFICATE_PATH=
DIAN_CERTIFICATE_PASSWORD=
DIAN_CLAVE_TECNICA=
DIAN_PROVIDER_URL=
DIAN_CONECTOR=mock
DIAN_MOCK_TRANSMISSION=true

# --- Imágenes (públicas en Docker Hub: https://hub.docker.com/u/deimer18) ---
# Docker Hub: REGISTRY=docker.io  REGISTRY_ORG=deimer18  (ya publicado)
# GHCR (cuando el CI del repo lo publique): REGISTRY=ghcr.io  REGISTRY_ORG=<owner>
REGISTRY=docker.io
REGISTRY_ORG=deimer18
TAG=latest

# --- Prefijo de nombres de contenedores (opcional, varios POS en un host) ---
CONTAINER_PREFIX=pos