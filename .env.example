# Copiar este archivo a .env y ajustar los valores por cliente.
# Requisito: SQL Server 2022 en Docker (el compose levanta el contenedor).

# --- SQL Server (una BD por cliente, en el equipo principal) ---
# Contrasena del usuario `sa`: debe cumplir politica de seguridad de SQL Server
# (mayuscula + minuscula + digito + simbolo, minimo 8 caracteres).
SA_PASSWORD=Pos2026Clave01!
SA_EDITION=Developer
# Memoria maxima en MB que usa SQL Server dentro del contenedor (opcional)
MSSQL_MEMORY_LIMIT_MB=2048
DB_NAME=posdb
# Puerto en la red local donde se expone SQL Server
DB_PORT_HOST=26433

# --- Seguridad backend ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Separar por coma. En producción indique solo los dominios autorizados.
CORS_ORIGINS=http://localhost:28742,http://127.0.0.1:28742
DEBUG=false

# --- DIAN (mantener disabled hasta completar habilitación y set de pruebas) ---
# No subir certificados, PIN ni claves técnicas al repositorio.
DIAN_ENVIRONMENT=disabled
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=
# Ruta dentro del servidor, con permisos de lectura solo para el backend.
DIAN_CERTIFICATE_PATH=
DIAN_CERTIFICATE_PASSWORD=
# Clave técnica (ClTec) que DIAN asigna a cada resolución de numeración.
DIAN_CLAVE_TECNICA=
# URL del proveedor tecnológico certificado, si se utiliza uno.
DIAN_PROVIDER_URL=
# 1 = ciclo DIAN simulado (enviar/consultar) para operar a diario sin conector.
# 0 = exigir el conector certificado antes de transmitir.
DIAN_MOCK_TRANSMISSION=true

# --- Usuarios iniciales (solo primera instalacion) ---
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_PASSWORD=cajero123
# 1 = obligar a cambiar la contrasena en el primer ingreso (recomendado)
SEED_ADMIN_FORCE_CHANGE=1

# --- Puertos para la red local (cajas y administracion) ---
# Frontend: abren este puerto en el navegador http://IP-del-principal:PORT
# (puerto no común para no exponer servicios obvios en la red local)
PORT=28742
# Backend (opcional, normalmente no se expone a las cajas)
BACKEND_PORT=28743

# --- Cloudflare Tunnel (link público sin montar la API en la nube) ---
# Crear el túnel en Zero Trust -> Networks -> Tunnels (modo remotamente gestionado),
# copiar el token y pegarlo aquí. Dominios (menú público y app protegida) se
# configuran en el panel de Cloudflare apuntando al servicio http://frontend:80
# (docker-compose expone el mismo frontend). Sin token, el túnel queda desactivado.
CF_TUNNEL_TOKEN=
