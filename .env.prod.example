# =============================================================
# PRODUCCIÓN — copiar a .env.prod en el VPS y rellenar.
# NUNCA commitear .env.prod; usar secretos/CICD o archivo local.
# Staging: copiar a .env.staging y usar DB_NAME=posdb_staging,
# SECRET_KEY/SA_PASSWORD distintas de producción.
# =============================================================

# --- Base de datos (por entorno: cambia SB_PASSWORD y DB_NAME) ---
SA_PASSWORD=CambiaEstaClaveProd2026!
DB_NAME=posdb
DB_PORT_HOST=26433

# --- App ---
SECRET_KEY=CambiaEstaClaveSecretaDeProduccionCon32+Caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false

# --- CORS: solo el dominio público del frontend ---
CORS_ORIGINS=https://app.tudominio.com.co

# --- Dominios públicos ---
DOMAIN_APP=app.tudominio.com.co
DOMAIN_API=api.tudominio.com.co
DOMAIN_DEMO=demo.tudominio.com.co

# --- DIAN (conector real) ---
DIAN_MOCK_TRANSMISSION=false
DIAN_CONECTOR=pst
DIAN_ENVIRONMENT=habilitacion
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=
DIAN_CERTIFICATE_PATH=/app/datos/certificado_cliente.p12
DIAN_CERTIFICATE_PASSWORD=
DIAN_CLAVE_TECNICA=
# URL del PST certificado (evita certificarse la empresa directamente)
DIAN_PROVIDER_URL=

# --- CI/CD ---
REGISTRY=ghcr.io
REGISTRY_ORG=tudominio
TAG=latest
GHCR_USER=
GHCR_TOKEN=