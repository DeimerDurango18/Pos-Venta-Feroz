# Caddy: TLS automático (Let's Encrypt) y enrutamiento hacia los contenedores.
# DOMAIN_APP y DOMAIN_API se inyectan desde compose.prod.yml (env).
# En staging se usa demo.<dominio> y api-demo.<dominio> (o el dominio que se defina).

{$DOMAIN_APP:app.dominio.co} {
	encode gzip

	# Frontend estático: nginx sirve dist y hace proxy /api hacia el backend.
	reverse_proxy frontend:80

	header / {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
}

{$DOMAIN_API:api.dominio.co} {
	encode gzip

	reverse_proxy backend:8000

	header / {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
	}
}